# Revenue Recovery Autopilot - Environment Variables Template
# Copy to .env for local testing (NEVER COMMIT REAL API KEYS)

# Groq LLM API Key
GROQ_API_KEY=your_groq_api_key_here

# Razorpay Test-Mode Credentials (Key ID must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_secret_here
